{
  "ripgrep": {
    "description": "递归搜索文件内容（rg）",
    "repo": "BurntSushi/ripgrep",
    "version": "latest",
    "asset": {
      "win32-x64": "ripgrep-{version}-x86_64-pc-windows-msvc.zip",
      "win32-arm64": "ripgrep-{version}-aarch64-pc-windows-msvc.zip",
      "linux-x64": "ripgrep-{version}-x86_64-unknown-linux-gnu.tar.gz",
      "linux-arm64": "ripgrep-{version}-aarch64-unknown-linux-gnu.tar.gz",
      "darwin-x64": "ripgrep-{version}-x86_64-apple-darwin.tar.gz",
      "darwin-arm64": "ripgrep-{version}-aarch64-apple-darwin.tar.gz"
    },
    "exe": {
      "win32": "rg.exe",
      "default": "rg"
    }
  },
  "fd": {
    "description": "更快的 find 替代品（fd）",
    "repo": "sharkdp/fd",
    "version": "latest",
    "asset": {
      "win32-x64": "fd-v{version}-x86_64-pc-windows-msvc.zip",
      "win32-arm64": "fd-v{version}-aarch64-pc-windows-msvc.zip",
      "linux-x64": "fd-v{version}-x86_64-unknown-linux-musl.tar.gz",
      "linux-arm64": "fd-v{version}-aarch64-unknown-linux-musl.tar.gz",
      "darwin-x64": "fd-v{version}-x86_64-apple-darwin.tar.gz",
      "darwin-arm64": "fd-v{version}-aarch64-apple-darwin.tar.gz"
    },
    "exe": {
      "win32": "fd.exe",
      "default": "fd"
    }
  },
  "jq": {
    "description": "命令行 JSON 处理器（jq）",
    "repo": "jqlang/jq",
    "version": "latest",
    "tag": "jq-{version}",
    "strip_prefix": ["jq-", "v"],
    "asset": {
      "win32-x64": "jq-windows-amd64.exe",
      "win32-arm64": "jq-windows-arm64.exe",
      "linux-x64": "jq-linux-amd64",
      "linux-arm64": "jq-linux-arm64",
      "darwin-x64": "jq-macos-amd64",
      "darwin-arm64": "jq-macos-arm64"
    },
    "exe": {
      "win32-x64": "jq-windows-amd64.exe",
      "win32-arm64": "jq-windows-arm64.exe",
      "linux-x64": "jq-linux-amd64",
      "linux-arm64": "jq-linux-arm64",
      "darwin-x64": "jq-macos-amd64",
      "darwin-arm64": "jq-macos-arm64"
    }
  },
  "yq": {
    "description": "命令行 YAML/JSON 处理器（yq）",
    "repo": "mikefarah/yq",
    "version": "latest",
    "asset": {
      "win32-x64": "yq_windows_amd64.exe",
      "win32-arm64": "yq_windows_arm64.exe",
      "linux-x64": "yq_linux_amd64",
      "linux-arm64": "yq_linux_arm64",
      "darwin-x64": "yq_darwin_amd64",
      "darwin-arm64": "yq_darwin_arm64"
    },
    "exe": {
      "win32-x64": "yq_windows_amd64.exe",
      "win32-arm64": "yq_windows_arm64.exe",
      "linux-x64": "yq_linux_amd64",
      "linux-arm64": "yq_linux_arm64",
      "darwin-x64": "yq_darwin_amd64",
      "darwin-arm64": "yq_darwin_arm64"
    }
  },
  "bat": {
    "description": "带语法高亮的 cat 替代品（bat）",
    "repo": "sharkdp/bat",
    "version": "latest",
    "asset": {
      "win32-x64": "bat-v{version}-x86_64-pc-windows-msvc.zip",
      "win32-arm64": "bat-v{version}-aarch64-pc-windows-msvc.zip",
      "linux-x64": "bat-v{version}-x86_64-unknown-linux-musl.tar.gz",
      "linux-arm64": "bat-v{version}-aarch64-unknown-linux-musl.tar.gz",
      "darwin-x64": "bat-v{version}-x86_64-apple-darwin.tar.gz",
      "darwin-arm64": "bat-v{version}-aarch64-apple-darwin.tar.gz"
    },
    "exe": {
      "win32": "bat.exe",
      "default": "bat"
    }
  },
  "fzf": {
    "description": "模糊查找器（fzf）",
    "repo": "junegunn/fzf",
    "version": "latest",
    "asset": {
      "win32-x64": "fzf-{version}-windows_amd64.zip",
      "win32-arm64": "fzf-{version}-windows_arm64.zip",
      "linux-x64": "fzf-{version}-linux_amd64.tar.gz",
      "linux-arm64": "fzf-{version}-linux_arm64.tar.gz",
      "darwin-x64": "fzf-{version}-darwin_amd64.tar.gz",
      "darwin-arm64": "fzf-{version}-darwin_arm64.tar.gz"
    },
    "exe": {
      "win32": "fzf.exe",
      "default": "fzf"
    }
  },
  "hyperfine": {
    "description": "命令行基准测试工具（hyperfine）",
    "repo": "sharkdp/hyperfine",
    "version": "latest",
    "asset": {
      "win32-x64": "hyperfine-v{version}-x86_64-pc-windows-msvc.zip",
      "win32-arm64": "hyperfine-v{version}-aarch64-pc-windows-msvc.zip",
      "linux-x64": "hyperfine-v{version}-x86_64-unknown-linux-musl.tar.gz",
      "linux-arm64": "hyperfine-v{version}-aarch64-unknown-linux-musl.tar.gz",
      "darwin-x64": "hyperfine-v{version}-x86_64-apple-darwin.tar.gz",
      "darwin-arm64": "hyperfine-v{version}-aarch64-apple-darwin.tar.gz"
    },
    "exe": {
      "win32": "hyperfine.exe",
      "default": "hyperfine"
    }
  },
  "shellcheck": {
    "description": "Shell 脚本静态检查（shellcheck）",
    "repo": "koalaman/shellcheck",
    "version": "latest",
    "asset": {
      "win32-x64": "shellcheck-v{version}.zip",
      "win32-arm64": "shellcheck-v{version}.zip",
      "linux-x64": "shellcheck-v{version}.linux.x86_64.tar.xz",
      "linux-arm64": "shellcheck-v{version}.linux.aarch64.tar.xz",
      "darwin-x64": "shellcheck-v{version}.darwin.x86_64.tar.xz",
      "darwin-arm64": "shellcheck-v{version}.darwin.aarch64.tar.xz"
    },
    "exe": {
      "win32": "shellcheck.exe",
      "default": "shellcheck"
    }
  },
  "protoc": {
    "description": "Protocol Buffers 编译器（protoc）",
    "repo": "protocolbuffers/protobuf",
    "version": "latest",
    "asset": {
      "win32-x64": "protoc-{version}-win64.zip",
      "win32-arm64": "protoc-{version}-win64.zip",
      "linux-x64": "protoc-{version}-linux-x86_64.zip",
      "linux-arm64": "protoc-{version}-linux-aarch_64.zip",
      "darwin-x64": "protoc-{version}-osx-x86_64.zip",
      "darwin-arm64": "protoc-{version}-osx-aarch_64.zip"
    },
    "exe": {
      "win32": "bin/protoc.exe",
      "default": "bin/protoc"
    }
  },
  "gitleaks": {
    "description": "Git 仓库密钥泄漏扫描（gitleaks）",
    "repo": "gitleaks/gitleaks",
    "version": "latest",
    "asset": {
      "win32-x64": "gitleaks_{version}_windows_x64.zip",
      "win32-arm64": "gitleaks_{version}_windows_arm64.zip",
      "linux-x64": "gitleaks_{version}_linux_x64.tar.gz",
      "linux-arm64": "gitleaks_{version}_linux_arm64.tar.gz",
      "darwin-x64": "gitleaks_{version}_darwin_x64.tar.gz",
      "darwin-arm64": "gitleaks_{version}_darwin_arm64.tar.gz"
    },
    "exe": {
      "win32": "gitleaks.exe",
      "default": "gitleaks"
    }
  }
}
